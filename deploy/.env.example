# Copy to deploy/.env. Locally (Caddy makes its own certificates for *.localhost):
ISSUER_HOST=issuer.localhost:8443
DEMO_HOST=demo.localhost:8443
HTTPS_PORT=8443
HTTP_PORT=8080
# On a server, with DNS pointing at it (Caddy gets certificates from Let's Encrypt):
# ISSUER_HOST=issuer.foaap.app
# DEMO_HOST=demo.foaap.app
# HTTPS_PORT=443
# HTTP_PORT=80
# When the page is served from another origin (foaap.app) that rewrites /api, /login, /consent, /operator and /vct
# here:
# DEMO_PUBLIC_URL=https://foaap.app
# To find out why a wallet app does not get through: the issuers log the reason for each refused request (the route,
# the error and the rule; never an address, a header, a token or what the request sent). Recreate cunho-pid and cunho-course after a change.
# LOG_REFUSALS=1
